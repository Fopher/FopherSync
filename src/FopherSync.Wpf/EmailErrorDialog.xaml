<Window x:Class="FopherSync.Wpf.EmailErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Email Test Failed" Width="540"
        SizeToContent="Height"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkestBrush}"
        BorderBrush="{StaticResource BorderSubtleBrush}"
        BorderThickness="1"
        ShowInTaskbar="False">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Content Area -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Red Error / Warning Icon -->
            <Border Grid.Column="0" Width="48" Height="48" Background="#2B1616" BorderBrush="{StaticResource DangerRedBrush}" BorderThickness="1" CornerRadius="24" VerticalAlignment="Top" Margin="0,4,18,0">
                <TextBlock Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Message Details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <TextBlock x:Name="TxtTitle" Text="SMTP Authentication Failed (Bad Credentials)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DangerRedBrush}" Margin="0,0,0,8" />
                <TextBlock x:Name="TxtMessage" Text="Your username or password was not accepted by the mail server. Gmail, Yahoo, and Outlook reject regular login passwords and require a 16-character App Password." FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="19" />
                <TextBlock x:Name="TxtTechnicalDetail" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas, Cascadia Code, monospace" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Bottom Action Bar -->
        <DockPanel Grid.Row="1">
            <Button x:Name="BtnNeedHelp" DockPanel.Dock="Left" Content="❓ Need Help?" Click="OnNeedHelpClick"
                    Background="#2A1B1B" BorderBrush="{StaticResource DangerRedBrush}" BorderThickness="1"
                    Foreground="#FF8A80" FontWeight="SemiBold" FontSize="13" Padding="14,8" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button DockPanel.Dock="Right" Content="OK" Click="OnOkClick" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Padding="20,8" MinWidth="80" />
        </DockPanel>
    </Grid>
</Window>
